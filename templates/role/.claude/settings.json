{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent _recall \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent sync"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "agent _status \"$CLAUDE_PROJECT_DIR\""
  }
}