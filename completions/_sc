#compdef sc scd
# zsh completion for sc / scd: subcommands, -a harness, role names, dirs.
local -a subs roles agents
subs=(
  'n:new session in $PWD'
  'a:pick a role (agent)'
  'p:pick a recent project'
)
agents=(claude codex opencode vibe)
local agentsdir="${SC_AGENTS_DIR:-/x/agents}" d
for d in "$agentsdir"/*/(N); do
  [[ -f "$d/CLAUDE.md" ]] && roles+=("${d:t}:role")
done
if [[ "${words[CURRENT-1]}" == "-a" || "${words[CURRENT-1]}" == "--agent" ]]; then
  _describe -t agents 'harness' agents
  return
fi
_describe -t subcommands 'sc command' subs
_describe -t roles 'role' roles
_describe -t options 'option' '(-a:harness)'
_files -/
