#!/usr/bin/env bash
# superclaude - Claude Code with tmux session management
# Inspired by agentbox session management

set -euo pipefail

# Harness per session: claude (default), codex, opencode, vibe. Chosen by
# `-a NAME`, $SC_AGENT, or a role's `.sc` file (`agent=codex`). The session
# keeps `sc|` as prefix; the harness is stored on the tmux session as @sc_agent.
SC_AGENT="${SC_AGENT:-claude}"
agent_cmd() {
    case "$1" in
        claude)   echo "env -u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_API_KEY claude --dangerously-skip-permissions" ;;
        codex)    echo "codex --dangerously-bypass-approvals-and-sandbox" ;;
        opencode) echo "${SO_OPENCODE_CMD:-opencode --auto}" ;;
        vibe)     echo "vibe --yolo --trust" ;;
        *) echo "unknown agent: $1 (claude|codex|opencode|vibe)" >&2; return 1 ;;
    esac
}
CLAUDE_CMD="$(agent_cmd "$SC_AGENT")" || exit 1

# Roles: one directory per specialist under $SC_AGENTS_DIR (a git repo synced
# between machines). A role dir carries CLAUDE.md, mcp.json, .claude/ and its
# own auto-memory, so `superclaude role home` is "Claude Code as the home
# specialist" without any further choice at start.
SC_AGENTS_DIR="${SC_AGENTS_DIR:-/x/agents}"
SESSION_PREFIX="sc"

# Share Codeman's dedicated tmux socket so sessions created here are visible in
# Codeman's web UI (and Codeman-created sessions are visible to `sc`). Codeman
# runs `tmux -L codeman` by default; mirror its own socket resolution so we stay
# aligned even under CODEMAN_INSTANCE. Precedence: SC_TMUX_SOCKET override wins,
# else CODEMAN_TMUX_SOCKET, else codeman[-<CODEMAN_INSTANCE>].
SC_TMUX_SOCKET="${SC_TMUX_SOCKET:-${CODEMAN_TMUX_SOCKET:-codeman${CODEMAN_INSTANCE:+-${CODEMAN_INSTANCE}}}}"

# All tmux calls go through the shared socket. (switch-client still respects the
# current $TMUX when invoked from inside a session on this same socket.)
tm() { tmux -L "$SC_TMUX_SOCKET" "$@"; }

# --- helpers ---

attach_or_switch() {
    # switch-client when inside tmux (e.g. invoked from display-popup),
    # attach-session otherwise.
    # NB: use `exec tmux -L …` directly, not the `tm` function — `exec` replaces
    # the shell with an external command and cannot exec a shell function.
    if [[ -n "${TMUX:-}" ]]; then
        exec tmux -L "$SC_TMUX_SOCKET" switch-client -t "=$1"
    else
        exec tmux -L "$SC_TMUX_SOCKET" attach-session -t "=$1"
    fi
}

slug() {
    local path="${1:-$(pwd)}"
    # tmux rewrites '.' and ':' to '_' in session names (they're reserved in
    # target specs as window.pane / session:window separators). Mirror that so
    # the name we create matches the name we later attach to.
    path="${path//[.:]/_}"
    echo "${SESSION_PREFIX}|${path}"
}

list_sessions() {
    local base_name
    base_name="$(slug)"
    tm list-sessions -F '#{session_name}' 2>/dev/null | grep -x "${base_name}\(-[0-9]\+\)\?" || true
}

next_session_name() {
    local base_name
    base_name="$(slug)"
    local existing
    existing="$(list_sessions)"

    # If base session doesn't exist, use it
    if ! echo "$existing" | grep -qx "$base_name"; then
        echo "$base_name"
        return
    fi

    # Find next available number
    local i=2
    while echo "$existing" | grep -qx "${base_name}-${i}"; do
        ((i++))
    done
    echo "${base_name}-${i}"
}

roles() {
    # A role is any dir under $SC_AGENTS_DIR that has a CLAUDE.md.
    local d
    for d in "$SC_AGENTS_DIR"/*/; do
        [[ -f "${d}CLAUDE.md" ]] && basename "$d"
    done 2>/dev/null
}

role_dir() {
    local d="$SC_AGENTS_DIR/$1"
    [[ -f "$d/CLAUDE.md" ]] || { echo "no such role: $1 (roles: $(roles | tr '\n' ' '))" >&2; return 1; }
    echo "$d"
}

ensure_role_memory() {
    # Claude Code keeps auto-memory under ~/.claude/projects/<encoded cwd>/memory.
    # Point that at <role>/memory so the role's memory lives in the synced repo.
    # Encoding mirrors Claude Code: '/' and '.' become '-'.
    local dir="$1" enc proj
    enc="${dir//[\/.]/-}"
    proj="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$enc"
    mkdir -p "$dir/memory" "$proj"
    if [[ -L "$proj/memory" ]]; then
        return 0
    fi
    if [[ -d "$proj/memory" ]]; then
        # Real dir from an earlier run: fold its files into the repo copy.
        cp -an "$proj/memory/." "$dir/memory/" 2>/dev/null || true
        rm -rf "$proj/memory"
    fi
    ln -s "$dir/memory" "$proj/memory"
}

usage() {
    cat <<'EOF'
superclaude - Claude Code with tmux session management

Usage:
  superclaude              Attach to existing session or create one
  superclaude new          Create a new session (auto-numbered)
  superclaude list         List sessions for current directory
  superclaude list all     Interactive picker (fzf) over ALL sc sessions
  superclaude attach NAME  Attach to a specific session
  superclaude kill NAME    Kill a specific session
  superclaude role ROLE    Attach or create the session of a role ($SC_AGENTS_DIR/ROLE)
  superclaude roles        List roles
  superclaude open DIR     Attach or create the session of a directory
  superclaude help         Show this help

Options (before the subcommand):
  -a, --agent NAME         Harness: claude (default), codex, opencode, vibe
                           (also $SC_AGENT, or `agent=NAME` in a role's .sc file)

Any other arguments are passed directly to claude.
EOF
}

pick_and_attach_all() {
    # One row per session: first active pane (lowest window_index — base-index aware).
    # pane_title carries Claude Code's conversation summary; pane_current_path is the
    # real cwd (more accurate than parsing the -N suffix off the slug).
    local rows
    rows="$(tm list-panes -a \
        -F $'#{session_name}\t#{pane_active}\t#{session_attached}\t#{session_activity}\t#{pane_current_command}\t#{pane_current_path}\t#{pane_title}' \
        2>/dev/null \
        | awk -F'\t' -v p="^${SESSION_PREFIX}\\|" '$1 ~ p && $2=="1" && !seen[$1]++' \
        | sort -t$'\t' -k4 -nr || true)"

    if [[ -z "$rows" ]]; then
        echo "No superclaude sessions running"
        return 0
    fi

    if ! command -v fzf >/dev/null 2>&1; then
        echo "fzf not installed; sessions:" >&2
        echo "$rows" | cut -f1
        return 1
    fi

    local selected=""
    selected="$(
        while IFS=$'\t' read -r name pactive attached activity cmd cwd title; do
            local marker=" "
            [[ "$attached" != "0" ]] && marker="●"
            local ts
            ts="$(date -d "@$activity" '+%m-%d %H:%M' 2>/dev/null || echo '-----')"
            # If claude isn't the foreground process, mark the row so it's obvious.
            local label="$title"
            [[ "$cmd" != "claude" ]] && label="[${cmd}] ${title}"
            printf '%s\t%s  %s  %-50.50s  %s\n' "$name" "$marker" "$ts" "$label" "$cwd"
        done <<< "$rows" \
        | fzf --with-nth=2.. --delimiter=$'\t' \
              --prompt='session> ' --header='● attached   enter: attach   esc: cancel' \
              --height=60% --reverse --no-multi \
        | cut -f1
    )" || selected=""

    if [[ -n "$selected" ]]; then
        attach_or_switch "$selected"
    fi
}

create_and_attach() {
    local session_name="$1" dir="${2:-$(pwd)}"
    tm new-session -d -s "$session_name" -c "$dir" "$CLAUDE_CMD"
    # set-option does not take the "=" exact-match prefix; the bare name is exact enough here.
    tm set-option -t "$session_name" @sc_agent "$SC_AGENT"
    echo "Created session: $session_name ($SC_AGENT)"
    attach_or_switch "$session_name"
}

role_agent() {
    # `agent=NAME` in <role>/.sc sets the role's default harness.
    local f="$1/.sc" a
    [[ -f "$f" ]] || return 0
    a="$(sed -n 's/^agent=//p' "$f" | tail -1)"
    [[ -n "$a" ]] && echo "$a"
}

attach_or_create_dir() {
    # Sticky session for an arbitrary directory (roles, recent projects).
    local dir="$1" existing
    existing="$(tm list-sessions -F '#{session_name}' 2>/dev/null | grep -x "$(slug "$dir")\(-[0-9]\+\)\?" | head -1 || true)"
    if [[ -n "$existing" ]]; then
        attach_or_switch "$existing"
    else
        create_and_attach "$(slug "$dir")" "$dir"
    fi
}

# --- main ---

# Global option: -a|--agent NAME (before the subcommand).
if [[ "${1:-}" == "-a" || "${1:-}" == "--agent" ]]; then
    SC_AGENT="${2:?agent name}"; SC_AGENT_EXPLICIT=1; shift 2
    CLAUDE_CMD="$(agent_cmd "$SC_AGENT")" || exit 1
fi

case "${1:-}" in
    "")
        # No args: attach to existing session or create one
        existing="$(list_sessions | head -1)"
        if [[ -n "$existing" ]]; then
            echo "Attaching to: $existing"
            attach_or_switch "$existing"
        else
            create_and_attach "$(slug)"
        fi
        ;;
    new)
        session_name="$(next_session_name)"
        create_and_attach "$session_name"
        ;;
    list)
        if [[ "${2:-}" == "all" ]]; then
            pick_and_attach_all
        else
            sessions="$(list_sessions)"
            if [[ -z "$sessions" ]]; then
                echo "No sessions for $(pwd)"
            else
                echo "Sessions for $(pwd):"
                echo "$sessions"
            fi
        fi
        ;;
    attach)
        if [[ -z "${2:-}" ]]; then
            echo "Usage: superclaude attach SESSION_NAME"
            exit 1
        fi
        attach_or_switch "$2"
        ;;
    kill)
        if [[ -z "${2:-}" ]]; then
            echo "Usage: superclaude kill SESSION_NAME"
            exit 1
        fi
        tm kill-session -t "=$2"
        echo "Killed session: $2"
        ;;
    role)
        [[ -n "${2:-}" ]] || { echo "Usage: superclaude role ROLE"; exit 1; }
        dir="$(role_dir "$2")" || exit 1
        ensure_role_memory "$dir"
        ra="$(role_agent "$dir")"
        if [[ -n "$ra" && "$ra" != "$SC_AGENT" && -z "${SC_AGENT_EXPLICIT:-}" ]]; then
            SC_AGENT="$ra"; CLAUDE_CMD="$(agent_cmd "$SC_AGENT")" || exit 1
        fi
        # MCP per role: with a mcp.json in the role dir, claude loads only that
        # list (no user-scope servers leak in). Other harnesses read their own
        # config; nothing to do for them here.
        if [[ "$SC_AGENT" == "claude" && -f "$dir/mcp.json" ]]; then
            CLAUDE_CMD="$CLAUDE_CMD --mcp-config $dir/mcp.json --strict-mcp-config"
        fi
        attach_or_create_dir "$dir"
        ;;
    roles)
        roles
        ;;
    open)
        [[ -d "${2:-}" ]] || { echo "Usage: superclaude open DIR"; exit 1; }
        attach_or_create_dir "$(cd "$2" && pwd)"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        # Pass everything through to claude
        exec $CLAUDE_CMD "$@"
        ;;
esac
