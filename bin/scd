#!/usr/bin/env bash
# scd — `sc` on another host over mosh: pick from *its* sessions, with mosh's
# roaming/reconnect for flaky links. Args go straight to the remote `sc`.
#   scd | scd n | scd <N> | scd NAME ...
# Host: SCD_HOST=user@host, from the environment or ~/.config/superclaude/config.
set -euo pipefail
conf="${SC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/superclaude/config}"
DEST="${SCD_HOST:-$( [[ -f "$conf" ]] && sed -n 's/^SCD_HOST=//p' "$conf" | tail -1 | tr -d '"' || true)}"
[[ -n "$DEST" ]] || { echo "scd: set SCD_HOST=user@host in $conf" >&2; exit 1; }
# mosh-server under the remote user's systemd scope: cgroup-clean, survives
# shell teardown
exec mosh --server='systemd-run --user --scope --collect mosh-server' \
    "$DEST" -- zsh -lc 'sc "$@"' sc "$@"
